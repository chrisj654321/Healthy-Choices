{
  "expo": {
    "name": "Food Exposé: Barcode Scanner",
    "slug": "healthychoices",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jamesadventure.healthychoices",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Food Exposé uses your camera to scan product barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "package": "com.jamesadventure.healthychoices",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Food Exposé uses your camera to scan product barcodes.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "./plugins/withFmtFix",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D9E75"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#1D9E75"
        }
      ],
      "expo-build-properties",
      "expo-sqlite",
      "expo-asset",
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "organization": "shelfexpose",
          "project": "react-native",
          "url": "https://sentry.io/"
        }
      ],
      "expo-sharing"
    ],
    "scheme": "healthychoices",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/158b3aec-7944-42f9-8427-c86ecc45176a"
    },
    "extra": {
      "eas": {
        "projectId": "158b3aec-7944-42f9-8427-c86ecc45176a"
      }
    },
    "owner": "chrisj654321"
  }
}
