{
  "expo": {
    "name": "Healthy Choices",
    "slug": "healthychoices",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "privacy": "public",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jamesadventure.healthychoices",
      "infoPlist": {
        "NSCameraUsageDescription": "Healthy Choices uses your camera to scan product barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "package": "com.jamesadventure.healthychoices",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Healthy Choices uses your camera to scan product barcodes."
        }
      ],
      "expo-secure-store",
      [
        "react-native-purchases",
        {
          "androidApiKey": "REPLACE_WITH_ANDROID_RC_KEY"
        }
      ]
    ],
    "scheme": "healthychoices"
  }
}
