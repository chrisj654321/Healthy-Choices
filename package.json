  "devDependencies": {
    "@babel/core": "^7.25.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "sharp": "^0.35.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.claude/"
    ]
