    "@react-navigation/stack": "^6.4.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~56.0.11",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-asset": "~56.0.18",
    "expo-auth-session": "~56.0.14",
    "expo-blur": "~56.0.4",
    "expo-build-properties": "~56.0.18",
    "expo-camera": "~56.0.8",
    "expo-crypto": "~56.0.4",
