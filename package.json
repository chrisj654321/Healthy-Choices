    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "lint": "eslint src",
    "test": "eslint src && jest",
    "upload:sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "content:init": "node scripts/content-factory/cli.js init",
    "content:research": "node scripts/content-factory/cli.js research",
    "content:claims": "node scripts/content-factory/cli.js claims",
    "content:produce": "node scripts/content-factory/cli.js produce",
    "content:review": "node scripts/content-factory/cli.js review",
    "content:brand-carousel": "node scripts/content-factory/branded-carousel.js",
    "content:visual-audit": "node scripts/content-factory/cli.js visual-audit",
    "content:upload-assets": "node scripts/content-factory/cli.js upload-assets",
    "content:buffer-channels": "node scripts/content-factory/cli.js buffer-channels",
    "content:buffer-drafts": "node scripts/content-factory/cli.js buffer-drafts",
    "content:metrics": "node scripts/content-factory/cli.js metrics",
    "content:backup": "node scripts/content-factory/cli.js backup",
    "content:health": "node scripts/content-factory/cli.js health",
    "content:community": "node scripts/content-factory/cli.js community",
    "content:board": "node scripts/content-factory/cli.js board",
    "content:pilot": "node scripts/content-factory/cli.js pilot",
    "content:test": "node --test scripts/content-factory/tests/*.acceptance.js"
